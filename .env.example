# basis takes no secrets to run. Both upstream sources are keyless and public.
# These exist only to override defaults during development.

# Seconds between upstream refreshes. Lower than 15 wastes calls: the reference
# price endpoint is itself cached for 15s upstream.
BASIS_REVALIDATE_SECONDS=60

# Comma-separated symbols rendered on the landing page. The full registry is 194
# tokens; the page features a subset for legibility.
BASIS_FEATURED=NVDA,SPY,AAPL,QQQ,TSLA,AMC

# Set to "1" to force the fallback capture and skip all upstream calls. Useful for
# offline work and for testing the DARK degradation path.
BASIS_OFFLINE=0

# --- Interpreter (optional) --------------------------------------------------
#
# Powers the plain-language explanations on /desk. Everything else works without
# it; unset, the panel says it is not running rather than erroring.
#
# Inference is deployment configuration, never compiled in. What makes an answer
# trustworthy lives in this repository: the frozen system prompt, the strict
# output schema, and the field verifier that drops any claim it cannot trace back
# to the reading it was served. None of that depends on where inference runs.
#
# All three are set in the host's environment. The real key goes in .env.local,
# which is gitignored — never here.
#
# INTERPRETER_API_KEY=
# INTERPRETER_ENDPOINT=
# INTERPRETER_MODEL=
